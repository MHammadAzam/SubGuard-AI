# SubGuard AI — Example Environment Configuration (Placeholders Only)
# Copy to .env for local configuration; NEVER commit real secrets to version control.

# Deployment environment: development | test | production
SUBGUARD_ENV=development

# Mandatory in production: random secret >= 32 characters (e.g., python -c "import secrets; print(secrets.token_urlsafe(48))")
SUBGUARD_SESSION_SECRET=replace-with-at-least-32-random-characters-before-production

# Initial administrator bootstrap (optional if creating admin via python -m app.security.bootstrap create-admin)
# SUBGUARD_BOOTSTRAP_ADMIN_USERNAME=pilot_admin
# SUBGUARD_BOOTSTRAP_ADMIN_PASSWORD=Replace-With-Strong-12Plus-Char-Password!
# SUBGUARD_BOOTSTRAP_ADMIN_DISPLAY_NAME=Pilot Administrator

# Persistent SQLite DB, upload storage, and rotating security audit log paths
SUBGUARD_DB_PATH=./data/subguard.db
SUBGUARD_UPLOAD_DIR=./data/uploads
SUBGUARD_AUDIT_LOG_PATH=./data/logs/security_audit.log

# HTTPS & proxy settings (enforced fail-closed when SUBGUARD_ENV=production)
# SUBGUARD_COOKIE_SECURE=true
# SUBGUARD_ENFORCE_HTTPS=true
# SUBGUARD_TRUSTED_PROXIES=127.0.0.1
# SUBGUARD_CORS_ORIGINS=https://subguard.example.com

# Extraction provider allowlist & cost controls (default keeps external/paid providers disabled)
SUBGUARD_ALLOWED_PROVIDERS=mock
EXTRACTION_PROVIDER=mock
SUBGUARD_ENABLE_DEMO_ENDPOINT=true

# Optional external provider credentials (only effective when explicitly added to SUBGUARD_ALLOWED_PROVIDERS)
# GEMINI_API_KEY=your-gemini-api-key-placeholder
# OPENROUTER_API_KEY=your-openrouter-api-key-placeholder

# Optional Tesseract binary path override if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Conservative 8 GB host resource limits
SUBGUARD_MAX_FILE_BYTES=15728640
SUBGUARD_MAX_ENDORSEMENT_FILES=10
SUBGUARD_MAX_CUMULATIVE_UPLOAD_BYTES=52428800
SUBGUARD_MAX_CONCURRENT_REVIEWS=2
SUBGUARD_MAX_CONCURRENT_SCRYPT=4
SUBGUARD_MAX_PROVIDER_IMAGES=12
SUBGUARD_MAX_PROVIDER_PAYLOAD_BYTES=12582912
